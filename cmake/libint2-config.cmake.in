# libint2-config.cmake
# --------------------
#
# Libint2 cmake module.
# This module sets the following variables in your project:
#
# ::
#
#   Libint2_EXT_VERSION - Libint2 version including buildid, such as beta.3. Prefer target variable.
#   Libint2_MAX_AM_ERI - maximum angular momentum level of Libint2 libraries for 4-center energy
#                        integrals. Prefer target variable.
#
#
# Available components:
#
# ::
#
# See https://github.com/evaleev/libint/blob/master/INSTALL.md#configuration-codes
# for more details on these codes.
#
#   multipole_hh_dD - search for including spherical multipole integrals
#   onebody_hh_dD   - search for library including 1-body integrals
#   eri_hhhh_dD     - search for library including 2-body integrals with 4 centers
#   eri_hhL_dD      - search for library including 2-body integrals with 3 centers
#   eri_hhl_dD      - ditto
#   eri_HH_dD       - search for library including 2-body integrals with 2 centers
#   eri_hh_dD       - ditto
#   g12_hhhh_dD     - search for library including F12 integrals with Gaussian factors
#   CXX             - search for library including the C++ API (Libint2::cxx target)
#   C               - search for the C library (always present)
#   Fortran         - search for library including the Fortran interface target
#   fortran         - ditto
#
#
# Exported targets:
#
# ::
#
# C/C++ targets are installed to libint2-targets-C.cmake and are always loaded.
# The Fortran target is installed to libint2-targets-Fortran.cmake and is loaded
# only if that file is present, so C and Fortran may be packaged separately
# (e.g., conda) with this one config file.
#
#   Libint2::int2    - the main Libint2 library (alias of int-shared or int-static)
#   Libint2::cxx     - the header-only C++ API (if built)
#   Libint2::fortran - the Fortran interface library that depends on Libint2::int2
#                      (alias of int_f; only if Fortran targets file present)
#
#                    cart       shell_set   used_by
#                    --------   ---------   -------
#                                                             ( psi4 requires runtime-setting of     )
#   ss - search for  standard + standard  = mpqc4, cp2k, psi4 (  solid harmonic ordering to Gaussian )
#   so - search for           + orca
#   is - search for  intv3    + standard  = mpqc3
#   io - search for           + orca
#   gs - search for  gamess   + standard  = gamess
#   go - search for           + orca
#   os - search for  orca     + standard
#   oo - search for           + orca      = orca
#   bs - search for  bagel    + standard  = bagel
#   bo - search for           + orca

@PACKAGE_INIT@

# N.B. this file is evaluated in the scope of the caller of find_package(Libint2)
#      hence all helper variables and macros are prefixed with _libint2_, the
#      variables are unset by _libint2_cleanup(), and variables of other
#      packages (e.g., Eigen3_DIR) are not modified

set(Libint2_EXT_VERSION "@LIBINT_EXT_VERSION@")

# undoes the changes of this file to the caller's scope (other than the results)
macro(_libint2_cleanup)
  set(CMAKE_MODULE_PATH "${_libint2_saved_CMAKE_MODULE_PATH}")
  unset(_libint2_saved_CMAKE_MODULE_PATH)
  unset(_libint2_eigen3_config)
  unset(_libint2_eigen3_dir)
  unset(_libint2_eigen3_dir_found)
  unset(_libint2_boost_config)
  unset(_libint2_boost_dir)
  unset(_libint2_eri)
  unset(_libint2_find_args)
  unset(_libint2_fortran_problem)
  unset(_libint2_saved_found)
  unset(_libint2_saved_found_defined)
  unset(_libint2_saved_not_found_message)
endmacro()

# appends to, rather than overwrites, Libint2_NOT_FOUND_MESSAGE, so that the
# reasons for several missing components are all reported
macro(_libint2_append_not_found_message _libint2_msg)
  if (Libint2_NOT_FOUND_MESSAGE)
    string(APPEND Libint2_NOT_FOUND_MESSAGE "; ")
  endif()
  string(APPEND Libint2_NOT_FOUND_MESSAGE "${_libint2_msg}")
endmacro()

# like find_dependency(), but cleans up before returning if the dependency is
# not found, and does not make a failure fatal unless Libint2 is REQUIRED
macro(_libint2_find_dependency _libint2_dep)
  set(_libint2_find_args ${ARGN})
  if (Libint2_FIND_QUIETLY)
    list(APPEND _libint2_find_args QUIET)
  endif()
  find_package(${_libint2_dep} ${_libint2_find_args})
  if (NOT ${_libint2_dep}_FOUND)
    set(Libint2_NOT_FOUND_MESSAGE "Libint2 could not be found because dependency ${_libint2_dep} could not be found")
    set(Libint2_FOUND FALSE)
    _libint2_cleanup()
    return()
  endif()
endmacro()

# make detectable the various cmake modules exported alongside
# * prepend to trump any pre-target FindEigen3.cmake modules lying around
# * restored at the end of this file, or before returning early
set(_libint2_saved_CMAKE_MODULE_PATH "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

if (@LIBINT2_REQUIRE_CXX_API@)  # LIBINT2_REQUIRE_CXX_API
    set(Libint2_CXX_FOUND 1)

    if(NOT TARGET Eigen3::Eigen)
      set(_libint2_eigen3_config "@Eigen3_CONFIG@")
      if (NOT _libint2_eigen3_config OR NOT EXISTS "${_libint2_eigen3_config}")
        if (_libint2_eigen3_config)  # empty if Eigen3 was found without its Eigen3Config.cmake
          message(WARNING "Libint2 library was built with Eigen3Config.cmake detected at ${_libint2_eigen3_config}, but this path is no longer valid; directory moved since Libint2 library build?")
        endif()
        _libint2_find_dependency(Eigen3)
      else()
        get_filename_component(_libint2_eigen3_dir "${_libint2_eigen3_config}" DIRECTORY)
        _libint2_find_dependency(Eigen3 HINTS "${_libint2_eigen3_dir}")
        # the caller's Eigen3_DIR takes precedence over the hint; using a different
        # Eigen than the one Libint2 was built with risks ABI mismatches with the
        # compiled C++ API (Libint2::int2-cxx)
        get_filename_component(_libint2_eigen3_dir_found "${Eigen3_DIR}" REALPATH)
        get_filename_component(_libint2_eigen3_dir "${_libint2_eigen3_dir}" REALPATH)
        if (NOT _libint2_eigen3_dir_found STREQUAL _libint2_eigen3_dir)
          message(WARNING "Libint2 was built with Eigen3 from ${_libint2_eigen3_dir}, but Eigen3 from ${_libint2_eigen3_dir_found} (Eigen3_DIR) will be used; make sure the two are ABI-compatible")
        endif()
      endif()
    endif()

    if (@LIBINT_HAS_SYSTEM_BOOST_PREPROCESSOR_VARIADICS@)  # LIBINT_HAS_SYSTEM_BOOST_PREPROCESSOR_VARIADICS
        # Boost headers _not_ unpacked to within `include/libint2/`
        if (NOT TARGET Boost::headers)
            set(_libint2_boost_config "@Boost_CONFIG@")
            if (NOT _libint2_boost_config OR NOT EXISTS "${_libint2_boost_config}")
              if (_libint2_boost_config)  # empty if Boost was found without its BoostConfig.cmake
                message(WARNING "Libint2 library was built with BoostConfig.cmake detected at ${_libint2_boost_config}, but this path is no longer valid; directory moved since Libint2 library build?")
              endif()
              _libint2_find_dependency(Boost 1.57)
            else()
              get_filename_component(_libint2_boost_dir "${_libint2_boost_config}" DIRECTORY)
              _libint2_find_dependency(Boost 1.57 HINTS "${_libint2_boost_dir}")
            endif()
        endif()
    else()
        if(NOT CMAKE_REQUIRED_QUIET)
            message(STATUS "Boost detected. satisfied by headers bundled with Libint2 distribution")
        endif()
    endif()
else()
    list(FIND Libint2_FIND_COMPONENTS CXX _l2_cxx_idx)
    if (NOT _l2_cxx_idx EQUAL -1)
        _libint2_append_not_found_message("Libint2 was built without the C++ API (LIBINT2_REQUIRE_CXX_API=OFF); Libint2::cxx is not available")
    endif()
    unset(_l2_cxx_idx)
endif()

# check orderings, AM, & derivatives components
# * LIBINT2_SHGAUSS_ORDERING = @LIBINT2_SHGAUSS_ORDERING@
# * LIBINT2_CARTGAUSS_ORDERING = @LIBINT2_CARTGAUSS_ORDERING@
# * LIBINT2_SHELL_SET = @LIBINT2_SHELL_SET@
set(Libint2_MAX_AM_ERI @Libint2_MAX_AM_ERI@)  # Libint2_MAX_AM_ERI
foreach(_libint2_eri @Libint2_CONFIG_COMPONENTS@)  # Libint2_CONFIG_COMPONENTS
    set(Libint2_${_libint2_eri}_FOUND 1)
endforeach()

# N.B. check_required_components() is deferred to the end of this file so that
# the language components can be resolved from the imported targets below
# rather than from configure-time options

# Import library targets
# * C/C++ targets always; Fortran targets only if separately installed. Using
#   EXISTS rather than the configure-time Fortran option so that separate C and Fortran
#   packages don't clobber this file.
if(NOT TARGET Libint2::int-shared AND NOT TARGET Libint2::int-static)
  include("${CMAKE_CURRENT_LIST_DIR}/libint2-targets-C.cmake")
endif()
set(Libint2_C_FOUND 1)

# The Fortran targets file is unusable if left behind (e.g., by a manual copy or
#   another package) next to a C library of different type: it then references
#   Libint2::int-shared, but only Libint2::int-static is present, or vice versa,
#   and sets Libint2_FOUND to FALSE. Since that must not take down consumers that
#   don't need Fortran, the Fortran component is just reported missing (fatal only
#   if required, else a warning). Libint2::fortran is created only for a usable
#   file, so a repeated find_package(Libint2) reports the same.
# N.B. a C-only build removes stale Fortran targets files from its build tree and
#   install tree, so only files placed otherwise are expected here
set(_libint2_fortran_problem "")
if(NOT TARGET Libint2::int_f AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/libint2-targets-Fortran.cmake")
  set(_libint2_saved_found_defined 0)
  if (DEFINED Libint2_FOUND)
    set(_libint2_saved_found_defined 1)
  endif()
  set(_libint2_saved_found "${Libint2_FOUND}")
  set(_libint2_saved_not_found_message "${Libint2_NOT_FOUND_MESSAGE}")
  include("${CMAKE_CURRENT_LIST_DIR}/libint2-targets-Fortran.cmake")
  if (DEFINED Libint2_FOUND AND NOT Libint2_FOUND)
    set(_libint2_fortran_problem "${Libint2_NOT_FOUND_MESSAGE}")
    if (_libint2_saved_found_defined)
      set(Libint2_FOUND "${_libint2_saved_found}")
    else()
      unset(Libint2_FOUND)
    endif()
    set(Libint2_NOT_FOUND_MESSAGE "${_libint2_saved_not_found_message}")
  elseif (TARGET Libint2::int_f AND NOT TARGET Libint2::fortran)
    add_library(Libint2::fortran ALIAS Libint2::int_f)
  endif()
endif()

# Create convenience aliases matching the build-tree names
if (TARGET Libint2::int-shared)
    if (NOT TARGET Libint2::int2)
        add_library(Libint2::int2 ALIAS Libint2::int-shared)
    endif()
elseif (TARGET Libint2::int-static)
    if (NOT TARGET Libint2::int2)
        add_library(Libint2::int2 ALIAS Libint2::int-static)
    endif()
endif()

if (TARGET Libint2::int-cxx-headeronly-shared)
    if (NOT TARGET Libint2::cxx)
        add_library(Libint2::cxx ALIAS Libint2::int-cxx-headeronly-shared)
    endif()
elseif (TARGET Libint2::int-cxx-headeronly-static)
    if (NOT TARGET Libint2::cxx)
        add_library(Libint2::cxx ALIAS Libint2::int-cxx-headeronly-static)
    endif()
endif()

# N.B. test the problem string with STREQUAL, as if(<var>) is false for strings
#   ending in -NOTFOUND
if (TARGET Libint2::fortran)
    set(Libint2_fortran_FOUND 1)
    set(Libint2_Fortran_FOUND 1)
elseif (NOT _libint2_fortran_problem STREQUAL "")
    set(_libint2_fortran_problem "Libint2 Fortran targets file ${CMAKE_CURRENT_LIST_DIR}/libint2-targets-Fortran.cmake does not match the Libint2 C library, perhaps left over from an earlier installation; Libint2::fortran is not available: ${_libint2_fortran_problem}")
    if (Libint2_FIND_REQUIRED_Fortran OR Libint2_FIND_REQUIRED_fortran)
        _libint2_append_not_found_message("${_libint2_fortran_problem}")
    elseif (NOT Libint2_FIND_QUIETLY)
        message(WARNING "${_libint2_fortran_problem}")
    endif()
elseif (Libint2_FIND_REQUIRED_Fortran OR Libint2_FIND_REQUIRED_fortran)
    _libint2_append_not_found_message("Libint2 Fortran component requested, but Fortran targets file ${CMAKE_CURRENT_LIST_DIR}/libint2-targets-Fortran.cmake not found or not usable; Libint2 was built without LIBINT2_ENABLE_FORTRAN=ON or the Fortran package is not installed")
endif()

check_required_components(Libint2)

_libint2_cleanup()
