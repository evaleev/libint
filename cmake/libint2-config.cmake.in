# libint2-config.cmake
# --------------------
#
# Libint2 cmake module.
# This module sets the following variables in your project:
#
# ::
#
#   Libint2_EXT_VERSION - Libint2 version including buildid, such as beta.3. Prefer target variable.
#   Libint2_MAX_AM_ERI - maximum angular momentum level of Libint2 libraries for 4-center energy
#                        integrals. Prefer target variable.
#
#
# Available components:
#
# ::
#
# See https://github.com/evaleev/libint/blob/master/INSTALL.md#configuration-codes
# for more details on these codes.
#
#   multipole_hh_dD - search for including spherical multipole integrals
#   onebody_hh_dD   - search for library including 1-body integrals
#   eri_hhhh_dD     - search for library including 2-body integrals with 4 centers
#   eri_hhL_dD      - search for library including 2-body integrals with 3 centers
#   eri_hhl_dD      - ditto
#   eri_HH_dD       - search for library including 2-body integrals with 2 centers
#   eri_hh_dD       - ditto
#   g12_hhhh_dD     - search for library including F12 integrals with Gaussian factors
#   CXX             - search for library including the C++ API (Libint2::cxx target)
#   fortran         - search for library including the fortran interface target
#
#                    cart       shell_set   used_by
#                    --------   ---------   -------
#                                                             ( psi4 requires runtime-setting of     )
#   ss - search for  standard + standard  = mpqc4, cp2k, psi4 (  solid harmonic ordering to Gaussian )
#   so - search for           + orca
#   is - search for  intv3    + standard  = mpqc3
#   io - search for           + orca
#   gs - search for  gamess   + standard  = gamess
#   go - search for           + orca
#   os - search for  orca     + standard
#   oo - search for           + orca      = orca
#   bs - search for  bagel    + standard  = bagel
#   bo - search for           + orca

@PACKAGE_INIT@

# N.B. this file is evaluated in the scope of the caller of find_package(Libint2)
#      hence all helper variables are prefixed with _libint2_ and unset at the
#      end, and variables of other packages (e.g., Eigen3_DIR) are not modified

set(Libint2_EXT_VERSION "@LIBINT_EXT_VERSION@")

# make detectable the various cmake modules exported alongside
# * prepend to trump any pre-target FindEigen3.cmake modules lying around
# * restored at the end of this file
set(_libint2_saved_CMAKE_MODULE_PATH "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

# check library language component
include(CMakeFindDependencyMacro)

if (@LIBINT2_REQUIRE_CXX_API@)  # LIBINT2_REQUIRE_CXX_API
    set(Libint2_CXX_FOUND 1)

    if(NOT TARGET Eigen3::Eigen)
      set(_libint2_eigen3_config "@Eigen3_CONFIG@")
      if (NOT _libint2_eigen3_config OR NOT EXISTS "${_libint2_eigen3_config}")
        if (_libint2_eigen3_config)  # empty if Eigen3 was found without its Eigen3Config.cmake
          message(WARNING "Libint2 library was built with Eigen3Config.cmake detected at ${_libint2_eigen3_config}, but this path is no longer valid; directory moved since Libint2 library build?")
        endif()
        find_dependency(Eigen3 REQUIRED)
      else()
        get_filename_component(_libint2_eigen3_dir "${_libint2_eigen3_config}" DIRECTORY)
        find_dependency(Eigen3 REQUIRED HINTS "${_libint2_eigen3_dir}")
      endif()
    endif()

    if (@LIBINT_HAS_SYSTEM_BOOST_PREPROCESSOR_VARIADICS@)  # LIBINT_HAS_SYSTEM_BOOST_PREPROCESSOR_VARIADICS
        # Boost headers _not_ unpacked to within `include/libint2/`
        if (NOT TARGET Boost::headers)
            set(_libint2_boost_config "@Boost_CONFIG@")
            if (NOT _libint2_boost_config OR NOT EXISTS "${_libint2_boost_config}")
              if (_libint2_boost_config)  # empty if Boost was found without its BoostConfig.cmake
                message(WARNING "Libint2 library was built with BoostConfig.cmake detected at ${_libint2_boost_config}, but this path is no longer valid; directory moved since Libint2 library build?")
              endif()
              find_dependency(Boost 1.57 REQUIRED)
            else()
              get_filename_component(_libint2_boost_dir "${_libint2_boost_config}" DIRECTORY)
              find_dependency(Boost 1.57 REQUIRED HINTS "${_libint2_boost_dir}")
            endif()
        endif()
    else()
        if(NOT CMAKE_REQUIRED_QUIET)
            message(STATUS "Boost detected. satisfied by headers bundled with Libint2 distribution")
        endif()
    endif()
else()
    list(FIND Libint2_FIND_COMPONENTS CXX _l2_cxx_idx)
    if (NOT _l2_cxx_idx EQUAL -1)
        set(Libint2_NOT_FOUND_MESSAGE "Libint2 was built without the C++ API (LIBINT2_REQUIRE_CXX_API=OFF); Libint2::cxx is not available")
    endif()
    unset(_l2_cxx_idx)
endif()

# check orderings, AM, & derivatives components
# * LIBINT2_SHGAUSS_ORDERING = @LIBINT2_SHGAUSS_ORDERING@
# * LIBINT2_CARTGAUSS_ORDERING = @LIBINT2_CARTGAUSS_ORDERING@
# * LIBINT2_SHELL_SET = @LIBINT2_SHELL_SET@
set(Libint2_MAX_AM_ERI @Libint2_MAX_AM_ERI@)  # Libint2_MAX_AM_ERI
foreach(_libint2_eri @Libint2_CONFIG_COMPONENTS@)  # Libint2_CONFIG_COMPONENTS
    set(Libint2_${_libint2_eri}_FOUND 1)
endforeach()

# N.B. check_required_components() is deferred to the end of this file so that
# the language components can be resolved from the imported targets below
# rather than from configure-time options

# Import library targets
if(NOT TARGET Libint2::int-shared AND NOT TARGET Libint2::int-static)
  include("${CMAKE_CURRENT_LIST_DIR}/libint2-targets.cmake")
endif()

# Create convenience aliases matching the build-tree names
if (TARGET Libint2::int-shared)
    if (NOT TARGET Libint2::int2)
        add_library(Libint2::int2 ALIAS Libint2::int-shared)
    endif()
elseif (TARGET Libint2::int-static)
    if (NOT TARGET Libint2::int2)
        add_library(Libint2::int2 ALIAS Libint2::int-static)
    endif()
endif()

if (TARGET Libint2::int-cxx-headeronly-shared)
    if (NOT TARGET Libint2::cxx)
        add_library(Libint2::cxx ALIAS Libint2::int-cxx-headeronly-shared)
    endif()
elseif (TARGET Libint2::int-cxx-headeronly-static)
    if (NOT TARGET Libint2::cxx)
        add_library(Libint2::cxx ALIAS Libint2::int-cxx-headeronly-static)
    endif()
endif()

if (TARGET Libint2::int_f)
    if (NOT TARGET Libint2::fortran)
        add_library(Libint2::fortran ALIAS Libint2::int_f)
    endif()
    set(Libint2_fortran_FOUND 1)
endif()

check_required_components(Libint2)

set(CMAKE_MODULE_PATH "${_libint2_saved_CMAKE_MODULE_PATH}")
unset(_libint2_saved_CMAKE_MODULE_PATH)
unset(_libint2_eigen3_config)
unset(_libint2_eigen3_dir)
unset(_libint2_boost_config)
unset(_libint2_boost_dir)
unset(_libint2_eri)
